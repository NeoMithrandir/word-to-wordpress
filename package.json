{
  "name": "word-to-wordpress",
  "version": "1.0.0",
  "description": "Efficiently convert Word documents to WordPress posts maintaining layout, footnotes, and citations",
  "main": "dist/server.js",
  "scripts": {
    "import:posts": "ts-node src/scripts/import-processed-posts.ts",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec ts-node src/server.ts",
    "client:dev": "cd client && cross-env PORT=3006 npm start",
    "build": "npm run server:build && npm run client:build",
    "server:build": "tsc",
    "client:build": "cd client && npm run build",
    "start": "node dist/server.js",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.9.0",
    "@types/pdf-parse": "^1.1.5",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "word",
    "wordpress",
    "converter",
    "docx",
    "export"
  ],
  "author": "",
  "license": "MIT"
}
