# Copy this file to `.env` in this same directory (word-to-wordpress repo root, next to package.json).

# Optional: API listen port (default 3007). Client Vite uses 3006 via npm run client:dev.
# PORT=3007

# Target WordPress (REST API — application password auth)
WP_SITE_URL=https://your-staging-site.example.com
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: path to processed-post JSON directory (defaults to bundled saved-posts/... if unset)
# PROCESSED_POSTS_DIR=C:/GitHub/word-to-wordpress/saved-posts/fetch-2026-04-06T20-10-48-433Z/processed-posts

# Optional: max JSON body size in MB (default 256). Upload still uses UPLOAD_LIMIT_MB.
# JSON_BODY_LIMIT_MB=256

# Optional: delay ms between REST requests (default 300)
# IMPORT_DELAY_MS=300

# Set to true when importing to a cloned site that already has attachments (reuse featured image IDs instead of re-uploading)
# IMPORT_REUSE_EXISTING_MEDIA=true

# Path to inscience-v2 (used after a successful public arthra.inscience.gr publish)
# Defaults to ../inscience-v2 relative to this repo
# INSCIENCE_V2_DIR=C:/GitHub/inscience-v2
# SIMPLIFICATIONS_TIMEOUT_MS=480000
#
# Rebuild + redeploy the public Astro site after simplifications.
# Default is Cloudflare from the sibling working tree (includes local
# data/simplifications/<slug>.json, no git push):
#   npm run deploy:cloudflare
# Use vercel to run `npx vercel --prod --yes` instead (also from the working tree).
# INSCIENCE_V2_DEPLOY=cloudflare
# INSCIENCE_V2_DEPLOY=vercel
# INSCIENCE_V2_DEPLOY_TIMEOUT_MS=900000
# CLOUDFLARE_API_TOKEN=
# VERCEL_TOKEN=

# Optional: Anthropic vision fallback for image filename/alt when the document
# has no real Word alt, caption, or useful nearby heading. Conversion continues
# without this key (title-slug fallback).
# ANTHROPIC_API_KEY=
# ANTHROPIC_IMAGE_SEO_MODEL=claude-sonnet-4-6

# Optional: LLM preview review (provider picker in the Preview & Edit step).
# Configure one or more keys; the UI lists only providers that have a key.
# ANTHROPIC_API_KEY=
# Model overrides apply only when the review request omits a model.
# Must be an allowlisted id from the Preview & Edit dropdown (not a display name).
# ANTHROPIC_REVIEW_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_REVIEW_MODEL=gpt-4.1
# GEMINI_API_KEY=
# GEMINI_REVIEW_MODEL=gemini-2.5-flash
